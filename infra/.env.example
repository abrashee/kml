###############################################################################
# POSTGRESQL STATEFUL DATABASE CONFIGURATIONS
###############################################################################
# Base/Default PostgreSQL instance admin credentials
POSTGRES_DB=kml_logistics
POSTGRES_USER=kml_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Dedicated databases managed via container initialization routines
USER_SERVICE_DB=kml_user
ORDER_SERVICE_DB=kml_order
INVENTORY_SERVICE_DB=kml_inventory
WAREHOUSE_SERVICE_DB=kml_warehouse
SHIPMENT_SERVICE_DB=kml_shipment

###############################################################################
# DISTRIBUTED MESSAGING & DISTRIBUTED DATA STORES
###############################################################################
# Apache Kafka event backbone cluster endpoint (Internal Docker listeners)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# RabbitMQ configuration properties
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=kml_broker
RABBITMQ_PASSWORD=change-me

# OpenSearch cluster endpoint for asynchronous inventory fuzzy search matching
KML_OPENSEARCH_URL=http://opensearch:9200

###############################################################################
# IDENTITY, ACCESS CONTROL & SERVICE-TO-SERVICE SECURITY
###############################################################################
# Pre-shared secret token for internal HTTP communication validation
KML_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Edge token generation params (User Service authentication boundary)
JWT_SECRET=local-development-jwt-secret-must-be-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

###############################################################################
# OBSERVABILITY, OPEN TELEMETRY & SYSTEM APM METRICS
###############################################################################
# Spring Boot Actuator & Micrometer Tracing Controls
MANAGEMENT_TRACING_ENABLED=true
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# OpenTelemetry collection ingestion endpoints (gRPC, HTTP, and Spring contexts)
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Distributed Trace UI Monitoring port visualization
JAEGER_UI_PORT=16686

###############################################################################
# EXTERNAL INGRESS PORTS (Host machine routing context)
###############################################################################
# Boundary Ingress & Core API Gateway
API_GATEWAY_PORT=8080

# Under-the-hood core backend JVM services
USER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
SHIPMENT_SERVICE_PORT=8084
WAREHOUSE_SERVICE_PORT=8085

# Client Interfaces & User Interfaces
ADMIN_FRONTEND_PORT=4200
CUSTOMER_FRONTEND_PORT=5173

# Observability Infrastructure Dashboards
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

###############################################################################
# INTERNAL CONTAINER SERVICE MESH ROUTING
###############################################################################
# Isolated inter-service endpoints maps for direct container-to-container calls
KML_SERVICES_USER_URL=http://user-service:8080
KML_SERVICES_ORDER_URL=http://order-service:8080
KML_SERVICES_WAREHOUSE_URL=http://warehouse-service:8080
KML_SERVICES_SHIPMENT_URL=http://shipment-service:8080
KML_SERVICES_INVENTORY_URL=http://inventory-service:8080

# Order fulfillment maps explicitly to inventory engine container
KML_SERVICES_FULFILLMENT_URL=http://inventory-service:8080
